{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "separate-pull-requests": false,
  "include-component-in-tag": true,
  "bootstrap-sha": "",
  "packages": {
    "onchain": {
      "release-type": "simple",
      "component": "onchain",
      "tag-prefix": "contracts-v",
      "changelog-path": "CHANGELOG.md"
    },
    "frontend": {
      "release-type": "node",
      "component": "frontend",
      "tag-prefix": "frontend-v",
      "changelog-path": "CHANGELOG.md"
    },
    "backend": {
      "release-type": "node",
      "component": "backend",
      "tag-prefix": "backend-v",
      "changelog-path": "CHANGELOG.md"
    }
  },
  "plugins": [
    {
      "type": "linked-versions",
      "groupName": "lyricsflip",
      "components": ["onchain", "frontend", "backend"]
    }
  ]
}